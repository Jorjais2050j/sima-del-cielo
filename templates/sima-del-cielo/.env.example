# Fuente de datos: local (JSON) | api (backend Node/Express)
VITE_DATA_SOURCE=local
VITE_API_URL=http://localhost:3000/api

# Opcional: activar Cloudinary para imágenes optimizadas (srcset, webp/avif)
VITE_CLOUDINARY_CLOUD_NAME=

# Opcional: sólo si se cambia de iframe embed a Google Maps JS API
VITE_GOOGLE_MAPS_API_KEY=
